{
  "name": "nexboard",
  "version": "1.2.0",
  "description": "Dashboard moderne de gestion d'entreprise — clients, projets, devis, factures",
  "type": "module",
  "bin": {
    "nexboard": "bin/nexboard.mjs"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "data/.gitkeep",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx --watch src/index.ts",
    "build": "tsc && node ./scripts/bundle-public.mjs",
    "start": "node --experimental-sqlite dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nexboard",
    "dashboard",
    "crm",
    "invoices",
    "quotes",
    "sqlite",
    "fastify",
    "react"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexyrosweb/nexboard.git"
  },
  "bugs": {
    "url": "https://github.com/nexyrosweb/nexboard/issues"
  },
  "homepage": "https://github.com/nexyrosweb/nexboard#readme",
  "publishConfig": {
    "access": "public"
  }
}
