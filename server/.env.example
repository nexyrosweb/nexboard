# Server API
PORT=3001
HOST=0.0.0.0

# Relative path to SQLite DB (from server/ directory)
DATABASE_PATH=./data/nexboard.db

# Frontend API URL (empty = Vite proxy /api in development)
VITE_API_URL=

# --- NexBoard 2.0 Alpha: authentication ---
# Keep false for local single-user v1.2-compatible mode.
# Set true for any network-exposed or multi-user deployment.
AUTH_ENABLED=false

# Required in production when AUTH_ENABLED=true (long random string).
# If missing with AUTH_ENABLED=true, an ephemeral secret is generated (sessions reset on restart).
AUTH_SECRET=

# Session lifetime in days (httpOnly cookie)
SESSION_DAYS=14

# Seed demo data only when creating a brand-new database file.
# Never reseeds an existing DB. Set false for empty production installs.
SEED_DEMO=true

# Node environment (affects secure cookies)
# NODE_ENV=production
